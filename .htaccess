# =========================================================
# Asrama IPB Ekasari — .htaccess SEO Configuration
# =========================================================

Options -Indexes

RewriteEngine On

# ----------------------------------------------------------
# 1. Force HTTPS (HTTP → HTTPS)
# ----------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------
# 2. Remove www (www → non-www)
# ----------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.asramaekasari\.com [NC]
RewriteRule ^ https://asramaekasari.com%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------
# 3. Serve index.html for / (avoid duplicate /index.html)
# ----------------------------------------------------------
DirectoryIndex index.html

# ----------------------------------------------------------
# 4. Charset UTF-8 for HTML
# ----------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml

# ----------------------------------------------------------
# 5. Browser Caching
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                  "access plus 1 hour"
  ExpiresByType text/css                   "access plus 1 month"
  ExpiresByType application/javascript     "access plus 1 month"
  ExpiresByType image/jpeg                 "access plus 6 months"
  ExpiresByType image/png                  "access plus 6 months"
  ExpiresByType image/webp                 "access plus 6 months"
  ExpiresByType image/gif                  "access plus 6 months"
  ExpiresByType image/svg+xml              "access plus 6 months"
  ExpiresByType application/json           "access plus 1 day"
  ExpiresByType application/xml            "access plus 1 day"
  ExpiresByType font/woff2                 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
# 6. Gzip Compression
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------
# 7. Security Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
